# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
/tmp/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# netlify
.netlify

# stray build artifact (accidental temp distDir written into the project)
/var
/tmp

# local scratch — staging area for files pending deletion (e.g. a repo tarball)
/_to_delete

# wayfinder maps and their tickets — the local-markdown issue tracker.
# PRIVATE BY REQUEST (2026-08-05): the repo is public, and the client chose a
# local tracker over GitHub Issues precisely so planning is not visible. If
# this line is ever removed, every map and ticket becomes public on the next
# push, which is the one failure mode this tracker exists to avoid.
/.scratch

# scratch/working assets — not used by the app (Next serves only /public)
/assets

# trial fonts — CoType Aeonik evaluation licence (NOT for the repo / production).
# The Aeonik local-font loader in src/app/layout.tsx is intentionally commented
# out; the live site uses Instrument Sans (Google). Re-download trials to A/B.
/font-trials
/src/fonts/*TRIAL*.otf
/src/fonts/*Trial*.otf
.claude/settings.local.json

# Netlify CLI local-deploy artefact (edge-function bundling)
deno.lock

# Claude Design source drops — the exported design project ("Website graphics
# request", ~204MB incl. a 105MB zip and the AdobeStock originals). It is
# design SOURCE, not app code: the site consumes captures of it under
# public/assets/graphics/. Ignored wherever it lands so a `git add -A` can
# never pull it in. Re-drops arrive as "… (2)", "… (3)" etc, hence the glob.
/src/components/Website graphics request*/
/design-refs/Website graphics request*/

# local working copy / backup dirs
/_local-backup

# Design-handoff drops and loose exports that land in src/components/ but are
# never imported (2026-08-05: 4.7MB of them reached a commit before this rule
# existed). App code lives in .tsx; imagery the site actually uses lives in
# /public. Anything else here is working material, not source.
/src/components/*.avif
/src/components/*.svg
/src/components/handoff/
/src/components/design_handoff_ember_palette/
