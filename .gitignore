# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
/tmp/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# netlify
.netlify

# stray build artifact (accidental temp distDir written into the project)
/var
/tmp

# local scratch — staging area for files pending deletion (e.g. a repo tarball)
/_to_delete

# scratch/working assets — not used by the app (Next serves only /public)
/assets

# trial fonts — CoType Aeonik evaluation licence (NOT for the repo / production).
# The Aeonik local-font loader in src/app/layout.tsx is intentionally commented
# out; the live site uses Instrument Sans (Google). Re-download trials to A/B.
/font-trials
/src/fonts/*TRIAL*.otf
/src/fonts/*Trial*.otf
.claude/settings.local.json

# Netlify CLI local-deploy artefact (edge-function bundling)
deno.lock

# Claude Design source drops — the exported design project ("Website graphics
# request", ~204MB incl. a 105MB zip and the AdobeStock originals). It is
# design SOURCE, not app code: the site consumes captures of it under
# public/assets/graphics/. Ignored wherever it lands so a `git add -A` can
# never pull it in. Re-drops arrive as "… (2)", "… (3)" etc, hence the glob.
/src/components/Website graphics request*/
/design-refs/Website graphics request*/

# local working copy / backup dirs
/_local-backup
